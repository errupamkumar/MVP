# Copy to .env to override. Every EXPO_PUBLIC_* value is baked into the app bundle.

# Where the Spring Boot API lives. Leave unset in development: the app uses the
# machine running Metro (phone on the same Wi-Fi) or localhost on web.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# Hide the one-tap demo accounts on the login screen for non-demo builds.
# EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS=false
